<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-t_normalization_guides" author="admin">
        <createTable tableName="t_normalization_guides">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="normalization_operation" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="param1" type="text"/>
            <column name="param2" type="text"/>
        </createTable>
    </changeSet>

</databaseChangeLog>