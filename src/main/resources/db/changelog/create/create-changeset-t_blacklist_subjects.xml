<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-t_blacklist_subjects" author="admin">
        <createTable tableName="t_blacklist_subjects">
            <column name="id" type="bigserial">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="download_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="blacklist" type="text"/>
            <column name="subject_type" type="text"/>
            <column name="name" type="text"/>
            <column name="birthdate" type="text"/>
            <column name="tax_number" type="text"/>
            <column name="address" type="text"/>
            <column name="pasport_series" type="text"/>
            <column name="passport_number" type="text"/>
            <column name="comment" type="text"/>
            <column name="is_published" type="boolean"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="t_blacklist_subjects"
                baseColumnNames="download_id"
                constraintName="fk_blacklist_subjects_download"
                referencedTableName="t_download_history"
                referencedColumnNames="id"
                deferrable="false" initiallyDeferred="false"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>